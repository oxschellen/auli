{
  "name": "auli-ui",
  "private": true,
  "version": "0.1.87",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css}\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css}\" \"*.js\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "npx react-doctor@latest",
    "gen:entities": "node ../scripts/tools/gen-frontend-entities.mjs",
    "gen:public": "../scripts/build-frontend-public.sh",
    "gen": "npm run gen:entities && npm run gen:public"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "axios": "^1.21.0",
    "framer-motion": "^14.9.1",
    "next-themes": "0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.1",
    "react-doctor": "^0.9.22",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
