index 0000000..68f8109
--- /dev/null
+++ b/auli-server/crates/auli-anon/src/reconhecedores/nome_dicionario.rs
@@ -0,0 +1,251 @@
+//! Reconhecedor de **nome de pessoa por dicionário de prenomes** — Fase 5, o "caminho 2" do plano.
+//!
+//! Complementa o [`nome_pessoa`](super::nome_pessoa) ancorado: onde aquele exige um gatilho
+//! (`contribuinte`, `Sr.`, …) imediatamente antes do nome, este reconhece o nome **solto** —
+//! `João da Silva Pereira solicitou a baixa` — porque sabe que `JOAO` é um prenome brasileiro.
+//! O porteiro deixa de ser o gatilho e passa a ser o dicionário.
+//!
+//! ## Os dados (gerados por `tools/gera_prenomes.py`, embutidos no binário)
+//! - [`PRENOMES`]: prenomes do Censo 2010 do IBGE (top-10.000 por sexo, ~19 mil após filtros),
+//!   ASCII maiúsculo sem acento — o formato do próprio IBGE (`JOAO`, `ANTONIO`).
+//! - [`TOPONIMOS`]: municípios brasileiros de nome composto (`BENTO GONCALVES`, `VERA CRUZ`,
+//!   `CARLOS BARBOSA`). Um candidato exatamente igual a um deles é rejeitado: em texto fiscal,
+//!   esses nomes são o município, não o cidadão. É o que permite MANTER `Bento`, `Vera` e
+//!   `Carlos` no dicionário em vez de sacrificá-los.
+//!
+//! ## Limitações assumidas (precisão vence recall, como em toda a família)
+//! - Nome de **1 token** segue fora (`o João pediu`): mascarar todo prenome isolado inundaria o
+//!   texto de falso positivo.
+//! - Prenome fora do dicionário (raro, estrangeiro, ou nas exclusões do gerador) passa.
+//! - Uma pessoa real chamada exatamente como um município composto (`Carlos Barbosa`) passa —
+//!   custo da guarda de topônimos, conhecido e aceito.
+
+use std::sync::LazyLock;
+
+use cloakrs_core::{Confidence, EntityType, Locale, PiiEntity, Recognizer, Span};
+use regex::Regex;
+
+use super::comum;
+
+const RECOGNIZER_ID: &str = "auli_nome_dicionario_v1";
+const LOCALES_BR: &[Locale] = &[Locale::BR];
+
+/// Sequência candidata: 2–5 tokens Titlecase com conectores — a mesma forma do núcleo do
+/// reconhecedor ancorado, com um token a mais de folga porque aqui o início do nome pode estar
+/// no meio da sequência (`Doutor João Silva`) e é encontrado token a token.
+static RE_SEQ: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r"\p{Lu}\p{L}+(?:\s+(?:d[aeo]s?\s+|e\s+)?\p{Lu}\p{L}+){1,4}")
+        .expect("regex de sequência capitalizada é válida")
+});
+
+/// Prenomes, ordenados (ASCII maiúsculo) — busca binária.
+static PRENOMES: LazyLock<Vec<&'static str>> = LazyLock::new(|| {
+    let v: Vec<&str> = include_str!("../../data/prenomes.txt")
+        .lines()
+        .filter(|l| !l.is_empty())
+        .collect();
+    debug_assert!(v.is_sorted(), "prenomes.txt deve vir ordenado do gerador");
+    v
+});
+
+/// Municípios compostos, ordenados (ASCII maiúsculo) — busca binária.
+static TOPONIMOS: LazyLock<Vec<&'static str>> = LazyLock::new(|| {
+    let v: Vec<&str> = include_str!("../../data/toponimos_compostos.txt")
+        .lines()
+        .filter(|l| !l.is_empty())
+        .collect();
+    debug_assert!(v.is_sorted(), "toponimos_compostos.txt deve vir ordenado do gerador");
+    v
+});
+
+/// Normaliza para o contrato do dicionário: caixa alta ASCII, sem acento (espelho da função
+/// `normaliza` do gerador Python). Caracteres fora do alfabeto pt-BR passam inalterados — não
+/// casarão com o dicionário, que é o comportamento certo.
+fn normaliza(texto: &str) -> String {
+    texto
+        .chars()
+        .map(|c| match c {
+            'á' | 'à' | 'â' | 'ã' | 'ä' | 'Á' | 'À' | 'Â' | 'Ã' | 'Ä' => 'A',
+            'é' | 'è' | 'ê' | 'ë' | 'É' | 'È' | 'Ê' | 'Ë' => 'E',
+            'í' | 'ì' | 'î' | 'ï' | 'Í' | 'Ì' | 'Î' | 'Ï' => 'I',
+            'ó' | 'ò' | 'ô' | 'õ' | 'ö' | 'Ó' | 'Ò' | 'Ô' | 'Õ' | 'Ö' => 'O',
+            'ú' | 'ù' | 'û' | 'ü' | 'Ú' | 'Ù' | 'Û' | 'Ü' => 'U',
+            'ç' | 'Ç' => 'C',
+            'ñ' | 'Ñ' => 'N',
+            _ => c.to_ascii_uppercase(),
+        })
+        .collect()
+}
+
+fn e_prenome(token: &str) -> bool {
+    PRENOMES.binary_search(&normaliza(token).as_str()).is_ok()
+}
+
+fn e_toponimo(candidato: &str) -> bool {
+    let norm = candidato
+        .split_whitespace()
+        .map(normaliza)
+        .collect::<Vec<_>>()
+        .join(" ");
+    TOPONIMOS.binary_search(&norm.as_str()).is_ok()
+}
+
+/// Conector de nome (`da`, `dos`, `e`): conta para o span, não como token de nome.
+fn e_conector(token: &str) -> bool {
+    matches!(token, "da" | "de" | "do" | "das" | "dos" | "e")
+}
+
+/// Reconhecedor de nome por dicionário. Sem estado — construir com [`Self::novo`].
+pub struct NomeDicionarioRecognizer;
+
+impl NomeDicionarioRecognizer {
+    #[must_use]
+    pub fn novo() -> Self {
+        Self
+    }
+
+    /// Aplica as guardas ao candidato já recortado (começando num prenome do dicionário).
+    fn valida_candidato(candidato: &str) -> bool {
+        let titulos = candidato
+            .split_whitespace()
+            .filter(|t| comum::titlecase(t))
+            .count();
+        titulos >= 2 && !comum::tem_stop(candidato) && !e_toponimo(candidato)
+    }
+}
+
+impl Recognizer for NomeDicionarioRecognizer {
+    fn id(&self) -> &str {
+        RECOGNIZER_ID
+    }
+
+    fn entity_type(&self) -> EntityType {
+        EntityType::Custom("nome".into())
+    }
+
+    fn supported_locales(&self) -> &[Locale] {
+        LOCALES_BR
+    }
+
+    fn scan(&self, text: &str) -> Vec<PiiEntity> {
+        let mut achados = Vec::new();
+
+        for m in RE_SEQ.find_iter(text) {
+            // Anda token a token dentro da sequência procurando o primeiro prenome do
+            // dicionário — assim `Doutor João Silva` emite `João Silva`, não nada.
+            let trecho = m.as_str();
+            let inicio_nome = trecho
+                .split_whitespace()
+                .filter(|t| !e_conector(t) && comum::titlecase(t))
+                .find(|t| e_prenome(t))
+                .and_then(|t| trecho.find(t));
+            let Some(rel) = inicio_nome else { continue };
+
+            let start = m.start() + rel;
+            let candidato = &text[start..m.end()];
+            if !comum::limites_ok(text, start, m.end()) {
+                continue;
+            }
+            if !Self::valida_candidato(candidato) {
+                continue;
+            }
+            achados.push(PiiEntity {
+                entity_type: self.entity_type(),
+                span: Span::new(start, m.end()),
+                text: candidato.to_string(),
+                confidence: Confidence::new(0.6).expect("confiança válida"),
+                recognizer_id: RECOGNIZER_ID.to_string(),
+            });
+        }
+
+        achados
+    }
+
+    fn validate(&self, candidate: &str) -> bool {
+        candidate
+            .split_whitespace()
+            .next()
+            .is_some_and(e_prenome)
+            && Self::valida_candidato(candidate)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn achados(text: &str) -> Vec<String> {
+        NomeDicionarioRecognizer::novo()
+            .scan(text)
+            .into_iter()
+            .map(|e| e.text)
+            .collect()
+    }
+
+    #[test]
+    fn nome_solto_sem_gatilho() {
+        // O caso que motivou a fase: o reconhecedor ancorado não pega.
+        assert_eq!(
+            achados("João da Silva Pereira solicitou a baixa da inscrição"),
+            ["João da Silva Pereira"]
+        );
+        assert_eq!(achados("Clara Silva pediu a certidão"), ["Clara Silva"]);
+    }
+
+    #[test]
+    fn prenome_no_meio_da_sequencia() {
+        // `Doutor` não está no dicionário; o nome começa no primeiro prenome encontrado.
+        assert_eq!(achados("Doutor João Silva assinou o laudo"), ["João Silva"]);
+    }
+
+    #[test]
+    fn acento_nao_atrapalha_o_lookup() {
+        // `Antônio` (com acento) precisa casar com `ANTONIO` (sem) via normalização.
+        assert_eq!(achados("Antônio Prado Neto compareceu"), ["Antônio Prado Neto"]);
+    }
+
+    #[test]
+    fn municipio_composto_nao_e_nome() {
+        assert!(achados("o contribuinte reside em Bento Gonçalves").is_empty());
+        assert!(achados("a filial de Vera Cruz não emitiu").is_empty());
+        assert!(achados("recolhe para Carlos Barbosa desde 2020").is_empty());
+        // …mas o prenome continua vivo fora do topônimo exato.
+        assert_eq!(achados("Vera Lúcia dos Santos informou"), ["Vera Lúcia dos Santos"]);
+    }
+
+    #[test]
+    fn exclusoes_do_gerador_nao_disparam() {
+        assert!(achados("no bairro Bela Vista da capital").is_empty());
+        assert!(achados("o evento Natal Luz atrai turistas").is_empty());
+        assert!(achados("a agência de Santa Maria atende").is_empty());
+    }
+
+    #[test]
+    fn um_token_nao_casa() {
+        assert!(achados("o João pediu a segunda via").is_empty());
+    }
+
+    #[test]
+    fn stoplist_continua_valendo() {
+        assert!(achados("Maria da Receita Estadual").is_empty());
+    }
+
+    #[test]
+    fn minusculas_e_siglas_nao_casam() {
+        assert!(achados("joão da silva pereira em minúsculas").is_empty());
+        assert!(achados("PARCELAMENTO ICMS RS").is_empty());
+    }
+
+    #[test]
+    fn respeita_boundaries() {
+        assert!(achados("xJoão Silva Pereira").is_empty());
+    }
+
+    #[test]
+    fn tipo_e_confianca_corretos() {
+        let e = &NomeDicionarioRecognizer::novo().scan("João Silva Pereira pediu")[0];
+        assert_eq!(e.entity_type, EntityType::Custom("nome".into()));
+        assert_eq!(e.confidence.value(), 0.6);
+        assert_eq!(e.recognizer_id, RECOGNIZER_ID);
+    }
+}
