diff --git a/tools/gera_prenomes.py b/tools/gera_prenomes.py
new file mode 100644
index 0000000..eb7fd44
--- /dev/null
+++ b/tools/gera_prenomes.py
@@ -0,0 +1,135 @@
+#!/usr/bin/env python3
+"""Gera os artefatos do `NomeDicionarioRecognizer` (auli-anon, Fase 5).
+
+Saídas (versionadas no repo, embutidas no binário via `include_str!`):
+
+- ``auli-server/crates/auli-anon/data/prenomes.txt`` — prenomes brasileiros do
+  Censo 2010 do IBGE, um por linha, ASCII maiúsculo (o formato do próprio IBGE:
+  ``JOAO``, ``ANTONIO``), ordenados para busca binária.
+- ``auli-server/crates/auli-anon/data/toponimos_compostos.txt`` — nomes de
+  municípios brasileiros com 2–4 tokens, normalizados (``BENTO GONCALVES``,
+  ``VERA CRUZ``), ordenados. Guarda anti-falso-positivo: um candidato a nome de
+  pessoa que seja EXATAMENTE um destes é rejeitado — em texto fiscal,
+  ``Bento Gonçalves`` é quase sempre o município, não o cidadão.
+
+Fontes (dados públicos de origem IBGE, espelhados no GitHub):
+
+- Prenomes: https://github.com/MedidaSP/nomes-brasileiros-ibge
+  (top-10.000 por sexo do Censo 2010, com frequência populacional).
+- Municípios: https://github.com/kelvins/municipios-brasileiros
+  (tabela completa dos 5.570 municípios, códigos IBGE).
+
+Uso:
+
+    git clone --depth 1 https://github.com/MedidaSP/nomes-brasileiros-ibge /tmp/nomes
+    git clone --depth 1 https://github.com/kelvins/municipios-brasileiros /tmp/mun
+    python3 tools/gera_prenomes.py \
+        --nomes-dir /tmp/nomes --municipios-csv /tmp/mun/csv/municipios.csv
+
+Decisões (espelham as travas do crate — ver nome_dicionario.rs):
+
+- ``FREQ_MINIMA = 0``: a lista inteira entra (o piso da fonte já é ~265
+  ocorrências no censo). Ajustável se o eval acusar ruído na cauda.
+- ``TAM_MINIMO = 3``: prenomes de 1–2 letras são descartados (colidem com
+  sigla e preposição capitalizada).
+- ``EXCLUSOES``: prenomes que são, na prática do texto fiscal, prefixo de
+  topônimo/logradouro ou palavra comum — a densidade de armadilha supera a
+  frequência como nome. A guarda de topônimos NÃO substitui esta lista:
+  ela só cobre municípios, e ``Santa Rita``/``Bela Vista`` são bairro e rua
+  em todo lugar.
+"""
+
+import argparse
+import csv
+import sys
+import unicodedata
+from pathlib import Path
+
+FREQ_MINIMA = 0
+TAM_MINIMO = 3
+
+# Prenomes com densidade de armadilha alta demais no domínio (topônimo,
+# logradouro, festividade). Perda de recall conhecida e aceita.
+EXCLUSOES = {
+    "SANTA",  # Santa Maria, Santa Rita, Santa Cecília…
+    "SANTO",  # Santo Ângelo, Santo Antônio…
+    "SAO",    # São (grafado sem acento na fonte)
+    "COSTA",  # sobrenome/palavra; freq. baixa como prenome
+    "SOL",    # Sol Nascente (bairro), energia solar…
+    "LUZ",    # Natal Luz, conta de luz…
+    "FLOR",   # Flor da Serra…
+    "BELA",   # Bela Vista (bairro em toda cidade)
+    "NATAL",  # a festividade e a capital
+}
+
+# Termos da STOPLIST do crate (comum.rs) que poderiam constar como prenome na
+# fonte — subtraídos por coerência: o recognizer os rejeitaria de todo jeito.
+STOPLIST_CRATE = {
+    "PESSOA", "FISICA", "JURIDICA", "CONTRIBUINTE", "SUBSTITUTO",
+    "SUBSTITUICAO", "VOSSA", "SENHORIA", "NOTA", "FISCAL", "FISCAIS",
+    "SIMPLES", "NACIONAL", "REGIME", "ESPECIAL", "INSCRICAO", "ESTADUAL",
+    "ESTADUAIS", "CADASTRO", "TRIBUTARIO", "TRIBUTARIA", "ICMS", "IPVA",
+    "ITCD", "AUDITOR", "ANALISTA", "RECEITA", "FAZENDA", "SEFAZ",
+    "SECRETARIA", "FEDERAL", "PORTAL", "ATENDIMENTO", "JUNTA", "ESTADO",
+    "MUNICIPIO", "PREFEITURA", "PORTO", "ALEGRE", "RIO", "GRANDE", "SUL",
+}
+
+
+def normaliza(texto: str) -> str:
+    """Caixa alta ASCII, sem acento — o mesmo contrato de `normaliza` no Rust."""
+    decomposto = unicodedata.normalize("NFD", texto)
+    ascii_puro = decomposto.encode("ascii", "ignore").decode("ascii")
+    return ascii_puro.upper()
+
+
+def carrega_prenomes(nomes_dir: Path) -> set[str]:
+    prenomes: set[str] = set()
+    csvs = sorted(nomes_dir.glob("ibge-*.csv"))
+    if not csvs:
+        sys.exit(f"nenhum ibge-*.csv em {nomes_dir}")
+    for arquivo in csvs:
+        with arquivo.open(newline="", encoding="utf-8") as f:
+            for linha in csv.DictReader(f):
+                nome = normaliza(linha["nome"].strip())
+                if int(linha["freq"]) < FREQ_MINIMA:
+                    continue
+                if len(nome) < TAM_MINIMO or not nome.isalpha():
+                    continue
+                if nome in EXCLUSOES or nome in STOPLIST_CRATE:
+                    continue
+                prenomes.add(nome)
+    return prenomes
+
+
+def carrega_toponimos(municipios_csv: Path) -> set[str]:
+    toponimos: set[str] = set()
+    with municipios_csv.open(newline="", encoding="utf-8") as f:
+        for linha in csv.DictReader(f):
+            nome = normaliza(linha["nome"].strip())
+            n_tokens = len(nome.split())
+            # Só compostos: é o formato que colide com "prenome + sobrenomes".
+            if 2 <= n_tokens <= 4:
+                toponimos.add(nome)
+    return toponimos
+
+
+def grava(caminho: Path, linhas: set[str]) -> None:
+    caminho.parent.mkdir(parents=True, exist_ok=True)
+    caminho.write_text("\n".join(sorted(linhas)) + "\n", encoding="utf-8")
+    print(f"{caminho}: {len(linhas)} entradas")
+
+
+def main() -> None:
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--nomes-dir", type=Path, required=True)
+    p.add_argument("--municipios-csv", type=Path, required=True)
+    raiz = Path(__file__).resolve().parent.parent
+    dados = raiz / "auli-server" / "crates" / "auli-anon" / "data"
+    args = p.parse_args()
+
+    grava(dados / "prenomes.txt", carrega_prenomes(args.nomes_dir))
+    grava(dados / "toponimos_compostos.txt", carrega_toponimos(args.municipios_csv))
+
+
+if __name__ == "__main__":
+    main()
