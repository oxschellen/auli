+
+/// Convivência sufixo × segmento (Fase 4 × Fase 6): em `Anderle Transportes Ltda`, os dois
+/// reconhecedores de razão social disparam — o span com o sufixo é mais longo e vence no dedup.
+#[test]
+fn sufixo_vence_segmento_na_mesma_razao() {
+    let anon = Anonimizador::novo().expect("construir anonimizador");
+    let r = anon
+        .anonimizar("a Anderle Transportes Ltda pediu o regime especial")
+        .expect("anonimizar");
+    assert_eq!(r.mapping.entries.len(), 1, "spans deveriam colapsar: {:?}", r.mapping.entries);
+    assert_eq!(
+        r.mapping.entries[0].original, "Anderle Transportes Ltda",
+        "o span com sufixo (mais longo) deveria vencer"
+    );
+}
+
+/// Convivência prenome × segmento (Fase 5 × Fase 6): `Rosa Transportes` é empresa, não pessoa —
+/// no empate de span, a confiança maior do segmento (0.65 > 0.6) decide o tipo.
+#[test]
+fn segmento_vence_prenome_no_mesmo_span() {
+    let anon = Anonimizador::novo().expect("construir anonimizador");
+    let r = anon
+        .anonimizar("a Rosa Transportes informou o extravio das notas")
+        .expect("anonimizar");
+    assert!(
+        r.texto.contains("[RAZAO_SOCIAL_1]"),
+        "segmento (0.65) deveria vencer o prenome (0.6): {}",
+        r.texto
+    );
+    assert!(!r.texto.contains("[NOME_"), "não pode sair como nome: {}", r.texto);
+}
