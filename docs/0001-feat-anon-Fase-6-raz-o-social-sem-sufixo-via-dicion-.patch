+/// Normaliza para o contrato do dicionário: caixa alta ASCII, sem acento (espelho da função
+/// `normaliza` de `tools/gera_prenomes.py`). Caracteres fora do alfabeto pt-BR passam inalterados — não
+/// casarão com o dicionário, que é o comportamento certo.
+pub(super) fn normaliza(texto: &str) -> String {
+    texto
+        .chars()
+        .map(|c| match c {
+            'á' | 'à' | 'â' | 'ã' | 'ä' | 'Á' | 'À' | 'Â' | 'Ã' | 'Ä' => 'A',
+            'é' | 'è' | 'ê' | 'ë' | 'É' | 'È' | 'Ê' | 'Ë' => 'E',
+            'í' | 'ì' | 'î' | 'ï' | 'Í' | 'Ì' | 'Î' | 'Ï' => 'I',
+            'ó' | 'ò' | 'ô' | 'õ' | 'ö' | 'Ó' | 'Ò' | 'Ô' | 'Õ' | 'Ö' => 'O',
+            'ú' | 'ù' | 'û' | 'ü' | 'Ú' | 'Ù' | 'Û' | 'Ü' => 'U',
+            'ç' | 'Ç' => 'C',
+            'ñ' | 'Ñ' => 'N',
+            _ => c.to_ascii_uppercase(),
+        })
+        .collect()
+}
