diff --git a/auli-server/crates/auli-anon/src/reconhecedores/razao_segmento.rs b/auli-server/crates/auli-anon/src/reconhecedores/razao_segmento.rs
new file mode 100644
index 0000000..511e482
--- /dev/null
+++ b/auli-server/crates/auli-anon/src/reconhecedores/razao_segmento.rs
@@ -0,0 +1,228 @@
+//! Reconhecedor de **razão social por termo de segmento** — Fase 6, o complemento do
+//! [`razao_social`](super::razao_social) para a razão **sem sufixo societário**.
+//!
+//! `Anderle Transportes` sem o `Ltda` vazava: o porteiro daquele reconhecedor é o sufixo. Aqui o
+//! porteiro é um **substantivo de ramo de atividade** ([`data/segmentos_razao.txt`]) dentro da
+//! sequência capitalizada: `Transportes`, `Padaria`, `Distribuidora`, `Metalúrgica`… É o formato
+//! do pequeno contribuinte — o que de fato aparece nas perguntas do NAVI — e não depende de lista
+//! de empresas (os dados abertos do CNPJ têm dezenas de milhões de razões; inviável embutir, e as
+//! "maiores do país" colidem com o português comum: Vale, Oi, Azul).
+//!
+//! Guardas além das da família (Titlecase, stoplist, boundaries):
+//! - exige ao menos um token Titlecase que **não** seja termo de segmento (o nome distintivo);
+//! - [`ARMADILHAS`]: tokens institucionais que formam bigramas legítimos com termo de segmento
+//!   (`Secretaria dos Transportes` cai na stoplist; `Federação das Indústrias`, `Câmara de
+//!   Comércio`, `Distrito`, `Terminal`… caem aqui). Lista local, não na stoplist global, para não
+//!   mudar o comportamento das Fases 4–5 (há sobrenomes legítimos como `Câmara`).
+//!
+//! Confiança **0.65**: acima do dicionário de prenomes (0.6) de propósito — em `Rosa Transportes`,
+//! o termo de segmento é sinal mais forte de empresa do que o prenome é de pessoa, e no empate de
+//! span quem decide é a confiança.
+
+use std::sync::LazyLock;
+
+use cloakrs_core::{Confidence, EntityType, Locale, PiiEntity, Recognizer, Span};
+use regex::Regex;
+
+use super::comum;
+
+const RECOGNIZER_ID: &str = "auli_razao_segmento_v1";
+const LOCALES_BR: &[Locale] = &[Locale::BR];
+
+/// Sequência candidata: 2–5 tokens Titlecase com conectores.
+static RE_SEQ: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r"\p{Lu}\p{L}+(?:\s+(?:d[aeo]s?\s+|e\s+)?\p{Lu}\p{L}+){1,4}")
+        .expect("regex de sequência capitalizada é válida")
+});
+
+/// Termos de segmento, normalizados e ordenados no carregamento (o arquivo é curado à mão e
+/// aceita comentários `#`, então a ordenação não é pré-condição dele).
+static SEGMENTOS: LazyLock<Vec<&'static str>> = LazyLock::new(|| {
+    let mut v: Vec<&str> = include_str!("../../data/segmentos_razao.txt")
+        .lines()
+        .map(str::trim)
+        .filter(|l| !l.is_empty() && !l.starts_with('#'))
+        .collect();
+    v.sort_unstable();
+    v
+});
+
+/// Tokens institucionais que formam bigramas legítimos com termo de segmento. Normalizados.
+const ARMADILHAS: &[&str] = &[
+    "ASSOCIACAO",
+    "AVENIDA",
+    "CAMARA",
+    "CENTRAL",
+    "CENTRO",
+    "CODIGO",
+    "CONFEDERACAO",
+    "CONSELHO",
+    "DEPARTAMENTO",
+    "DIREITO",
+    "DISTRITO",
+    "FEDERACAO",
+    "FEIRA",
+    "FUNDO",
+    "MINISTERIO",
+    "PARQUE",
+    "PLANO",
+    "POLO",
+    "PROGRAMA",
+    "RUA",
+    "SETOR",
+    "SINDICATO",
+    "SISTEMA",
+    "TERMINAL",
+    "ZONA",
+];
+
+fn e_segmento(token: &str) -> bool {
+    SEGMENTOS
+        .binary_search(&comum::normaliza(token).as_str())
+        .is_ok()
+}
+
+fn e_armadilha(token: &str) -> bool {
+    ARMADILHAS.contains(&comum::normaliza(token).as_str())
+}
+
+/// Reconhecedor de razão social por segmento. Sem estado — construir com [`Self::novo`].
+pub struct RazaoSegmentoRecognizer;
+
+impl RazaoSegmentoRecognizer {
+    #[must_use]
+    pub fn novo() -> Self {
+        Self
+    }
+
+    fn valida_candidato(candidato: &str) -> bool {
+        let tokens: Vec<&str> = candidato.split_whitespace().collect();
+        if tokens.iter().any(|t| e_armadilha(t)) || comum::tem_stop(candidato) {
+            return false;
+        }
+        let titulos: Vec<&&str> = tokens.iter().filter(|t| comum::titlecase(t)).collect();
+        let segmentos = titulos.iter().filter(|t| e_segmento(t)).count();
+        // Um termo de segmento E um nome distintivo, ambos Titlecase.
+        segmentos >= 1 && titulos.len() - segmentos >= 1
+    }
+}
+
+impl Recognizer for RazaoSegmentoRecognizer {
+    fn id(&self) -> &str {
+        RECOGNIZER_ID
+    }
+
+    fn entity_type(&self) -> EntityType {
+        EntityType::Custom("razao_social".into())
+    }
+
+    fn supported_locales(&self) -> &[Locale] {
+        LOCALES_BR
+    }
+
+    fn scan(&self, text: &str) -> Vec<PiiEntity> {
+        let mut achados = Vec::new();
+
+        for m in RE_SEQ.find_iter(text) {
+            if !comum::limites_ok(text, m.start(), m.end()) {
+                continue;
+            }
+            if !Self::valida_candidato(m.as_str()) {
+                continue;
+            }
+            achados.push(PiiEntity {
+                entity_type: self.entity_type(),
+                span: Span::new(m.start(), m.end()),
+                text: m.as_str().to_string(),
+                confidence: Confidence::new(0.65).expect("confiança válida"),
+                recognizer_id: RECOGNIZER_ID.to_string(),
+            });
+        }
+
+        achados
+    }
+
+    fn validate(&self, candidate: &str) -> bool {
+        RE_SEQ
+            .find(candidate)
+            .is_some_and(|m| m.as_str() == candidate)
+            && Self::valida_candidato(candidate)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn achados(text: &str) -> Vec<String> {
+        RazaoSegmentoRecognizer::novo()
+            .scan(text)
+            .into_iter()
+            .map(|e| e.text)
+            .collect()
+    }
+
+    #[test]
+    fn razao_sem_sufixo() {
+        // O caso que motivou a fase.
+        assert_eq!(
+            achados("a Anderle Transportes não consegue emitir o MDF-e"),
+            ["Anderle Transportes"]
+        );
+        assert_eq!(achados("compras na Padaria do Vale caem no crédito?"), ["Padaria do Vale"]);
+        assert_eq!(
+            achados("a Metalúrgica Gaúcha atrasou o recolhimento"),
+            ["Metalúrgica Gaúcha"]
+        );
+        // Segmento no meio: o span é a sequência inteira.
+        assert_eq!(
+            achados("dívida da Silva Comércio de Bebidas"),
+            ["Silva Comércio de Bebidas"]
+        );
+    }
+
+    #[test]
+    fn acento_no_termo_de_segmento() {
+        // `Metalúrgica`/`Ótica` (com acento) casam com METALURGICA/OTICA (sem).
+        assert_eq!(achados("na Ótica Andrade desde 2019"), ["Ótica Andrade"]);
+    }
+
+    #[test]
+    fn segmento_sozinho_nao_casa() {
+        // Falta o nome distintivo.
+        assert!(achados("o setor de Transportes cresceu").is_empty());
+        assert!(achados("Padaria aberta aos domingos").is_empty());
+    }
+
+    #[test]
+    fn armadilhas_institucionais_nao_casam() {
+        assert!(achados("a Federação das Indústrias apresentou a pauta").is_empty());
+        assert!(achados("a Câmara de Comércio local promoveu o evento").is_empty());
+        assert!(achados("no Distrito das Indústrias de Gravataí").is_empty());
+        assert!(achados("o Terminal de Mudanças fechou").is_empty());
+    }
+
+    #[test]
+    fn stoplist_continua_valendo() {
+        // `Secretaria` está na stoplist global.
+        assert!(achados("a Secretaria dos Transportes autorizou").is_empty());
+    }
+
+    #[test]
+    fn minusculas_nao_casam() {
+        assert!(achados("os transportes rodoviários intermunicipais").is_empty());
+    }
+
+    #[test]
+    fn respeita_boundaries() {
+        assert!(achados("xAnderle Transportes").is_empty());
+    }
+
+    #[test]
+    fn tipo_e_confianca_corretos() {
+        let e = &RazaoSegmentoRecognizer::novo().scan("a Anderle Transportes pediu")[0];
+        assert_eq!(e.entity_type, EntityType::Custom("razao_social".into()));
+        assert_eq!(e.confidence.value(), 0.65);
+        assert_eq!(e.recognizer_id, RECOGNIZER_ID);
+    }
+}
